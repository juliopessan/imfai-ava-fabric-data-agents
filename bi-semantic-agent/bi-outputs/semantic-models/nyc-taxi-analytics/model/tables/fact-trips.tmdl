/// Fact Table: Trip Transactions
/// Grain: One row per taxi trip
/// Type: Transaction Fact
/// Rows: ~238,000 (Q2-Q3 2021)
/// Created: 2026-02-05

table fact_trips
	lineageTag: 8f3e4b5a-9c2d-4e1f-8a3b-7d2e5f6a8b9c

	/// Surrogate Key
	column trip_sk
		dataType: int64
		isHidden: true
		isKey: true
		formatString: 0
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567890
		summarizeBy: none
		sourceColumn: trip_sk

		annotation SummarizationSetBy = Automatic

	/// Natural Key
	column trip_id
		dataType: int64
		isHidden: true
		formatString: 0
		lineageTag: b2c3d4e5-f6a7-8901-bcde-f12345678901
		summarizeBy: none
		sourceColumn: trip_id

		annotation SummarizationSetBy = Automatic

	/// Foreign Keys
	column date_sk
		dataType: int64
		isHidden: true
		formatString: 0
		lineageTag: c3d4e5f6-a7b8-9012-cdef-123456789012
		summarizeBy: none
		sourceColumn: date_sk

		annotation SummarizationSetBy = Automatic

	column payment_type_sk
		dataType: int64
		isHidden: true
		formatString: 0
		lineageTag: d4e5f6a7-b8c9-0123-def1-234567890123
		summarizeBy: none
		sourceColumn: payment_type_sk

		annotation SummarizationSetBy = Automatic

	column rate_code_sk
		dataType: int64
		isHidden: true
		formatString: 0
		lineageTag: e5f6a7b8-c9d0-1234-ef12-345678901234
		summarizeBy: none
		sourceColumn: rate_code_sk

		annotation SummarizationSetBy = Automatic

	column trip_type_sk
		dataType: int64
		isHidden: true
		formatString: 0
		lineageTag: f6a7b8c9-d0e1-2345-f123-456789012345
		summarizeBy: none
		sourceColumn: trip_type_sk

		annotation SummarizationSetBy = Automatic

	column pickup_location_sk
		dataType: int64
		isHidden: true
		formatString: 0
		lineageTag: a7b8c9d0-e1f2-3456-1234-567890123456
		summarizeBy: none
		sourceColumn: pickup_location_sk

		annotation SummarizationSetBy = Automatic

	column dropoff_location_sk
		dataType: int64
		isHidden: true
		formatString: 0
		lineageTag: b8c9d0e1-f2a3-4567-2345-678901234567
		summarizeBy: none
		sourceColumn: dropoff_location_sk

		annotation SummarizationSetBy = Automatic

	/// Degenerate Dimensions
	column vendor_id
		dataType: int64
		formatString: 0
		lineageTag: c9d0e1f2-a3b4-5678-3456-789012345678
		summarizeBy: none
		sourceColumn: vendor_id

		annotation SummarizationSetBy = Automatic

	column passenger_count
		dataType: int64
		formatString: 0
		lineageTag: d0e1f2a3-b4c5-6789-4567-890123456789
		summarizeBy: sum
		sourceColumn: passenger_count

		annotation SummarizationSetBy = Automatic

	/// Measures (Continuous - Distances & Durations)
	column trip_distance
		dataType: decimal
		formatString: #,0.00
		lineageTag: e1f2a3b4-c5d6-7890-5678-901234567890
		summarizeBy: sum
		sourceColumn: trip_distance

		annotation SummarizationSetBy = Automatic
		annotation __PBI_FormatHint = {"isGeneralNumber":false}

	column trip_duration_min
		dataType: int64
		formatString: 0
		lineageTag: f2a3b4c5-d6e7-8901-6789-012345678901
		summarizeBy: sum
		sourceColumn: trip_duration_min

		annotation SummarizationSetBy = Automatic

	/// Measures (Additive - Financial)
	column fare_amount
		dataType: decimal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: a3b4c5d6-e7f8-9012-7890-123456789012
		summarizeBy: sum
		sourceColumn: fare_amount

		annotation SummarizationSetBy = Automatic
		annotation __PBI_FormatHint = {"currencyCulture":"en-US"}

	column extra_amount
		dataType: decimal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: b4c5d6e7-f8a9-0123-8901-234567890123
		summarizeBy: sum
		sourceColumn: extra_amount

		annotation SummarizationSetBy = Automatic

	column mta_tax
		dataType: decimal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: c5d6e7f8-a9b0-1234-9012-345678901234
		summarizeBy: sum
		sourceColumn: mta_tax

		annotation SummarizationSetBy = Automatic

	column tip_amount
		dataType: decimal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: d6e7f8a9-b0c1-2345-0123-456789012345
		summarizeBy: sum
		sourceColumn: tip_amount

		annotation SummarizationSetBy = Automatic

	column tolls_amount
		dataType: decimal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: e7f8a9b0-c1d2-3456-1234-567890123456
		summarizeBy: sum
		sourceColumn: tolls_amount

		annotation SummarizationSetBy = Automatic

	column improvement_surcharge
		dataType: decimal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: f8a9b0c1-d2e3-4567-2345-678901234567
		summarizeBy: sum
		sourceColumn: improvement_surcharge

		annotation SummarizationSetBy = Automatic

	column congestion_surcharge
		dataType: decimal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: a9b0c1d2-e3f4-5678-3456-789012345678
		summarizeBy: sum
		sourceColumn: congestion_surcharge

		annotation SummarizationSetBy = Automatic

	column total_amount
		dataType: decimal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: b0c1d2e3-f4a5-6789-4567-890123456789
		summarizeBy: sum
		sourceColumn: total_amount

		annotation SummarizationSetBy = Automatic

	/// Derived Measures (Pre-calculated in Gold Layer)
	column revenue_per_mile
		dataType: decimal
		formatString: \$#,0.0000;(\$#,0.0000);\$#,0.0000
		lineageTag: c1d2e3f4-a5b6-7890-5678-901234567890
		summarizeBy: average
		sourceColumn: revenue_per_mile

		annotation SummarizationSetBy = Automatic

	column revenue_per_minute
		dataType: decimal
		formatString: \$#,0.0000;(\$#,0.0000);\$#,0.0000
		lineageTag: d2e3f4a5-b6c7-8901-6789-012345678901
		summarizeBy: average
		sourceColumn: revenue_per_minute

		annotation SummarizationSetBy = Automatic

	column tip_percentage
		dataType: decimal
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e3f4a5b6-c7d8-9012-7890-123456789012
		summarizeBy: average
		sourceColumn: tip_percentage

		annotation SummarizationSetBy = Automatic

	/// DAX Measures
	measure 'Total Trips' = COUNTROWS(fact_trips)
		formatString: #,0
		displayFolder: Key Metrics

	measure 'Total Revenue' = SUM(fact_trips[total_amount])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Financial

	measure 'Avg Revenue Per Trip' = DIVIDE([Total Revenue], [Total Trips])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Financial

	measure 'Total Passengers' = SUM(fact_trips[passenger_count])
		formatString: #,0
		displayFolder: Operational

	measure 'Avg Passengers Per Trip' = DIVIDE([Total Passengers], [Total Trips], 0)
		formatString: 0.00
		displayFolder: Operational

	measure 'Total Distance (Miles)' = SUM(fact_trips[trip_distance])
		formatString: #,0.00
		displayFolder: Operational

	measure 'Avg Distance Per Trip' = DIVIDE([Total Distance (Miles)], [Total Trips], 0)
		formatString: 0.00
		displayFolder: Operational

	measure 'Total Duration (Minutes)' = SUM(fact_trips[trip_duration_min])
		formatString: #,0
		displayFolder: Operational

	measure 'Avg Duration Per Trip' = DIVIDE([Total Duration (Minutes)], [Total Trips], 0)
		formatString: 0.00
		displayFolder: Operational

	measure 'Total Tips' = SUM(fact_trips[tip_amount])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Financial

	measure 'Avg Tip Percentage' = 
		DIVIDE(
			SUM(fact_trips[tip_amount]),
			SUM(fact_trips[fare_amount]),
			0
		)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Financial

	measure 'Revenue Per Mile' = DIVIDE([Total Revenue], [Total Distance (Miles)], 0)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Efficiency

	measure 'Revenue Per Minute' = DIVIDE([Total Revenue], [Total Duration (Minutes)], 0)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Efficiency

	/// Time Intelligence Measures
	measure 'Total Revenue YTD' = 
		TOTALYTD([Total Revenue], dim_date[full_date])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Time Intelligence

	measure 'Total Revenue PY' = 
		CALCULATE([Total Revenue], SAMEPERIODLASTYEAR(dim_date[full_date]))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Time Intelligence

	measure 'Revenue Growth YoY' = 
		DIVIDE(
			[Total Revenue] - [Total Revenue PY],
			[Total Revenue PY],
			0
		)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Time Intelligence

	measure 'Total Trips MTD' = 
		TOTALMTD([Total Trips], dim_date[full_date])
		formatString: #,0
		displayFolder: Time Intelligence

	/// KPI Targets (from kpis.md)
	measure 'Avg Revenue Per Trip Target' = 14.00
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Targets

	measure 'Avg Revenue vs Target' = 
		[Avg Revenue Per Trip] - [Avg Revenue Per Trip Target]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Targets

	measure 'Avg Revenue Achievement %' = 
		DIVIDE([Avg Revenue Per Trip], [Avg Revenue Per Trip Target], 0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Targets

	/// Partition
	partition fact_trips = m
		mode: directQuery
		source = 
			let
				Source = AzureDatabricks.Catalogs("adb-####.##.azuredatabricks.net", "/sql/1.0/warehouses/####", [Catalog="nyc_taxi"]),
				gold = Source{[Name="gold"]}[Data],
				fact_trips = gold{[Name="fact_trips"]}[Data]
			in
				fact_trips

	annotation PBI_ResultType = Table
	annotation PBI_NavigationStepName = Navigation
