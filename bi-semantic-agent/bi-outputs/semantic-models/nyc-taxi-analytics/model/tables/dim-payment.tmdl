/// Dimension Table: Payment Type
/// Grain: One row per payment type
/// Type: Type 1 SCD (Overwrite)
/// Rows: 6
/// Created: 2026-02-05

table dim_payment
	lineageTag: 1a2b3c4d-5e6f-7890-abcd-ef9876543210

	/// Surrogate Key
	column payment_type_sk
		dataType: int64
		isKey: true
		formatString: 0
		lineageTag: 2b3c4d5e-6f7a-8901-bcde-f98765432101
		summarizeBy: none
		sourceColumn: payment_type_sk

		annotation SummarizationSetBy = Automatic

	/// Natural Key
	column payment_type_id
		dataType: int64
		formatString: 0
		lineageTag: 3c4d5e6f-7a8b-9012-cdef-e98765432102
		summarizeBy: none
		sourceColumn: payment_type_id

		annotation SummarizationSetBy = Automatic

	/// Attributes
	column payment_type_desc
		dataType: string
		lineageTag: 4d5e6f7a-8b9c-0123-def1-d98765432103
		summarizeBy: none
		sourceColumn: payment_type_desc

		annotation SummarizationSetBy = Automatic

	column is_electronic
		dataType: boolean
		formatString: "TRUE";"TRUE";"FALSE"
		lineageTag: 5e6f7a8b-9c0d-1234-ef12-c98765432104
		summarizeBy: none
		sourceColumn: is_electronic

		annotation SummarizationSetBy = Automatic

	column is_tracked
		dataType: boolean
		formatString: "TRUE";"TRUE";"FALSE"
		lineageTag: 6f7a8b9c-0d1e-2345-f123-b98765432105
		summarizeBy: none
		sourceColumn: is_tracked

		annotation SummarizationSetBy = Automatic

	/// DAX Measures
	measure 'Payment Type Count' = COUNTROWS(dim_payment)
		formatString: #,0
		displayFolder: Payment Metrics

	measure 'Selected Payment Type' = SELECTEDVALUE(dim_payment[payment_type_desc], "All Payment Types")
		displayFolder: Payment Metrics

	/// Partition
	partition dim_payment = m
		mode: import
		source = 
			let
				Source = AzureDatabricks.Catalogs("adb-####.##.azuredatabricks.net", "/sql/1.0/warehouses/####", [Catalog="nyc_taxi"]),
				gold = Source{[Name="gold"]}[Data],
				dim_payment = gold{[Name="dim_payment"]}[Data]
			in
				dim_payment

	annotation PBI_ResultType = Table
