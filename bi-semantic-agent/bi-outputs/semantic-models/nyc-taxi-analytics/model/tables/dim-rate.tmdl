/// Dimension Table: Rate Code
/// Grain: One row per rate code type
/// Type: Type 1 SCD (Overwrite)
/// Rows: 7
/// Created: 2026-02-05

table dim_rate
	lineageTag: a1b2c3d4-e5f6-7890-abcd-123456789abc

	/// Surrogate Key
	column rate_code_sk
		dataType: int64
		isKey: true
		formatString: 0
		lineageTag: b2c3d4e5-f6a7-8901-bcde-234567890bcd
		summarizeBy: none
		sourceColumn: rate_code_sk

		annotation SummarizationSetBy = Automatic

	/// Natural Key
	column rate_code_id
		dataType: int64
		formatString: 0
		lineageTag: c3d4e5f6-a7b8-9012-cdef-345678901cde
		summarizeBy: none
		sourceColumn: rate_code_id

		annotation SummarizationSetBy = Automatic

	/// Attributes
	column rate_code_desc
		dataType: string
		lineageTag: d4e5f6a7-b8c9-0123-def1-456789012def
		summarizeBy: none
		sourceColumn: rate_code_desc

		annotation SummarizationSetBy = Automatic

	column is_airport
		dataType: boolean
		formatString: "TRUE";"TRUE";"FALSE"
		lineageTag: e5f6a7b8-c9d0-1234-ef12-567890123ef0
		summarizeBy: none
		sourceColumn: is_airport

		annotation SummarizationSetBy = Automatic

	column is_flat_rate
		dataType: boolean
		formatString: "TRUE";"TRUE";"FALSE"
		lineageTag: f6a7b8c9-d0e1-2345-f123-678901234f01
		summarizeBy: none
		sourceColumn: is_flat_rate

		annotation SummarizationSetBy = Automatic

	/// DAX Measures
	measure 'Rate Code Count' = COUNTROWS(dim_rate)
		formatString: #,0
		displayFolder: Rate Metrics

	measure 'Selected Rate Code' = SELECTEDVALUE(dim_rate[rate_code_desc], "All Rate Codes")
		displayFolder: Rate Metrics

	measure '% Airport Trips' = 
		DIVIDE(
			CALCULATE([Total Trips], dim_rate[is_airport] = TRUE()),
			[Total Trips],
			0
		)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Rate Metrics

	/// Partition
	partition dim_rate = m
		mode: import
		source = 
			let
				Source = AzureDatabricks.Catalogs("adb-####.##.azuredatabricks.net", "/sql/1.0/warehouses/####", [Catalog="nyc_taxi"]),
				gold = Source{[Name="gold"]}[Data],
				dim_rate = gold{[Name="dim_rate"]}[Data]
			in
				dim_rate

	annotation PBI_ResultType = Table
