# Copie este arquivo para .env e ajuste os valores.
# .env nunca deve ser commitado (ja esta no .gitignore).

# Ambiente de execucao
MIGRATION_ENV=development
LOG_LEVEL=INFO

# Tenant ativo (deve corresponder a um arquivo em config/tenants/<TENANT_ID>.yaml)
TENANT_ID=default
TENANT_CONFIG_PATH=/app/config/tenant-config.yaml

# Parametros de execucao
DB_RETRY_COUNT=3
TIMEOUT_SEC=60
