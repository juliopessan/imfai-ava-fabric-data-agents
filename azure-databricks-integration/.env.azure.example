# ══════════════════════════════════════════════════════════════════════════════
# AZURE DATABRICKS CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════
# Para usar este arquivo:
# 1. Renomeie para '.env' (sem o .azure)
# 2. Substitua os valores SUBSTITUA_* pelos valores reais
# 3. Nunca commite o arquivo .env no Git!
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────────────
# WORKSPACE URL
# ──────────────────────────────────────────────────────────────────────────────
# Como obter:
# 1. Acesse o portal Azure: https://portal.azure.com
# 2. Navegue até seu Azure Databricks workspace
# 3. Copie a "Workspace URL"
# Formato: adb-123456789012.13.azuredatabricks.net (sem https://)
DATABRICKS_HOST=adb-SUBSTITUA_PELO_SEU_WORKSPACE.azuredatabricks.net

# ──────────────────────────────────────────────────────────────────────────────
# PERSONAL ACCESS TOKEN
# ──────────────────────────────────────────────────────────────────────────────
# Como gerar:
# 1. Acesse: https://<seu-workspace>.azuredatabricks.net/
# 2. Clique no ícone do usuário (canto superior direito)
# 3. User Settings → Developer → Access Tokens
# 4. Generate New Token
# 5. Defina um nome (ex: "Data Migration Pipeline") e validade (90 dias)
# 6. IMPORTANTE: Copie o token imediatamente (ele só aparece uma vez!)
DATABRICKS_TOKEN=dapi_SUBSTITUA_PELO_SEU_TOKEN

# ──────────────────────────────────────────────────────────────────────────────
# SQL WAREHOUSE HTTP PATH
# ──────────────────────────────────────────────────────────────────────────────
# Como obter:
# 1. Acesse: https://<seu-workspace>.azuredatabricks.net/sql/warehouses
# 2. Clique no SQL Warehouse desejado (ou crie um novo - tipo Serverless recomendado)
# 3. Na aba "Connection details", copie o campo "HTTP Path"
# Formato: /sql/1.0/warehouses/xxxxxxxxxxxxx
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/SUBSTITUA_PELO_SEU_WAREHOUSE_ID

# ──────────────────────────────────────────────────────────────────────────────
# SQL WAREHOUSE ID (Alternativa ao HTTP Path acima)
# ──────────────────────────────────────────────────────────────────────────────
# Como obter:
# 1. Acesse: https://<seu-workspace>.azuredatabricks.net/sql/warehouses
# 2. Clique no SQL Warehouse
# 3. Copie o ID da URL (após /warehouses/)
# Nota: Se já preencheu DATABRICKS_HTTP_PATH, pode deixar esta variável em branco
DATABRICKS_SQL_WAREHOUSE_ID=

# ──────────────────────────────────────────────────────────────────────────────
# AZURE CREDENTIALS (Opcional - para provisionamento via script)
# ──────────────────────────────────────────────────────────────────────────────
# Necessário apenas se quiser usar Service Principal em vez de login interativo
# Para obter estes valores:
# 1. Azure Portal → Azure Active Directory → App registrations
# 2. Crie um novo App Registration ou use existente
# 3. Copie Application (client) ID, Directory (tenant) ID
# 4. Em "Certificates & secrets", crie um novo client secret

# AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=seu-secret-aqui

# ══════════════════════════════════════════════════════════════════════════════
# COMO USAR ESTE ARQUIVO
# ══════════════════════════════════════════════════════════════════════════════
# 
# 1. Copie este arquivo:
#    cp .env.azure.example .env
#
# 2. Substitua todos os valores 'SUBSTITUA_*' pelos valores reais
#
# 3. Salve o arquivo
#
# 4. Execute os scripts:
#    cd azure-databricks-integration/05-orchestration
#    .\run-all.ps1
#
# 5. Para testar se está configurado:
#    cd azure-databricks-integration/04-data-ingestion
#    python -c "from dotenv import load_dotenv; import os; load_dotenv(); print('Host:', os.getenv('DATABRICKS_HOST'))"
#
# ══════════════════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════════════════════
# EXEMPLO PREENCHIDO (apenas para referência - substitua com seus valores!)
# ══════════════════════════════════════════════════════════════════════════════
# DATABRICKS_HOST=adb-1234567890123456.13.azuredatabricks.net
# DATABRICKS_TOKEN=dapi1234567890abcdef1234567890abcdef
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/1234567890abcdef
# ══════════════════════════════════════════════════════════════════════════════
