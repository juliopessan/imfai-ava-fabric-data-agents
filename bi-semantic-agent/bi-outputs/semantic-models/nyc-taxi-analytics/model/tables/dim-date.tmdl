/// Dimension Table: Date Calendar
/// Grain: One row per calendar day
/// Type: Type 0 SCD (Static)
/// Rows: 1,826 (2021-01-01 to 2025-12-31)
/// Created: 2026-02-05

table dim_date
	lineageTag: 1a2b3c4d-5e6f-7890-abcd-ef1234567890
	dataCategory: Time

	/// Surrogate Key (YYYYMMDD format)
	column date_sk
		dataType: int64
		isKey: true
		formatString: 0
		lineageTag: 2b3c4d5e-6f7a-8901-bcde-f12345678901
		summarizeBy: none
		sourceColumn: date_sk

		annotation SummarizationSetBy = Automatic

	/// Natural Key - Date
	column full_date
		dataType: dateTime
		isDataTypeInferred: false
		formatString: Short Date
		lineageTag: 3c4d5e6f-7a8b-9012-cdef-123456789012
		summarizeBy: none
		sourceColumn: full_date

		annotation SummarizationSetBy = Automatic
		annotation UnderlyingDateTimeDataType = Date

		annotation __PBI_LocalDateTable = true

	/// Day Attributes
	column day_of_week
		dataType: int64
		formatString: 0
		lineageTag: 4d5e6f7a-8b9c-0123-def1-234567890123
		summarizeBy: none
		sourceColumn: day_of_week

		annotation SummarizationSetBy = Automatic

	column day_name
		dataType: string
		lineageTag: 5e6f7a8b-9c0d-1234-ef12-345678901234
		summarizeBy: none
		sourceColumn: day_name
		sortByColumn: day_of_week

		annotation SummarizationSetBy = Automatic

	column day_of_month
		dataType: int64
		formatString: 0
		lineageTag: 6f7a8b9c-0d1e-2345-f123-456789012345
		summarizeBy: none
		sourceColumn: day_of_month

		annotation SummarizationSetBy = Automatic

	column day_of_year
		dataType: int64
		formatString: 0
		lineageTag: 7a8b9c0d-1e2f-3456-1234-567890123456
		summarizeBy: none
		sourceColumn: day_of_year

		annotation SummarizationSetBy = Automatic

	/// Week Attributes
	column week_of_year
		dataType: int64
		formatString: 0
		lineageTag: 8b9c0d1e-2f3a-4567-2345-678901234567
		summarizeBy: none
		sourceColumn: week_of_year

		annotation SummarizationSetBy = Automatic

	/// Month Attributes
	column month_num
		dataType: int64
		formatString: 0
		lineageTag: 9c0d1e2f-3a4b-5678-3456-789012345678
		summarizeBy: none
		sourceColumn: month_num

		annotation SummarizationSetBy = Automatic

	column month_name
		dataType: string
		lineageTag: 0d1e2f3a-4b5c-6789-4567-890123456789
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month_num

		annotation SummarizationSetBy = Automatic

	column month_short
		dataType: string
		lineageTag: 1e2f3a4b-5c6d-7890-5678-901234567890
		summarizeBy: none
		sourceColumn: month_short
		sortByColumn: month_num

		annotation SummarizationSetBy = Automatic

	/// Quarter Attributes
	column quarter
		dataType: int64
		formatString: 0
		lineageTag: 2f3a4b5c-6d7e-8901-6789-012345678901
		summarizeBy: none
		sourceColumn: quarter

		annotation SummarizationSetBy = Automatic

	column quarter_name
		dataType: string
		lineageTag: 3a4b5c6d-7e8f-9012-7890-123456789012
		summarizeBy: none
		sourceColumn: quarter_name
		sortByColumn: quarter

		annotation SummarizationSetBy = Automatic

	/// Year Attributes
	column year
		dataType: int64
		formatString: 0
		lineageTag: 4b5c6d7e-8f9a-0123-8901-234567890123
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	column year_month
		dataType: string
		lineageTag: 5c6d7e8f-9a0b-1234-9012-345678901234
		summarizeBy: none
		sourceColumn: year_month

		annotation SummarizationSetBy = Automatic

	/// Flags
	column is_weekend
		dataType: boolean
		formatString: "TRUE";"TRUE";"FALSE"
		lineageTag: 6d7e8f9a-0b1c-2345-0123-456789012345
		summarizeBy: none
		sourceColumn: is_weekend

		annotation SummarizationSetBy = Automatic

	column is_holiday
		dataType: boolean
		formatString: "TRUE";"TRUE";"FALSE"
		lineageTag: 7e8f9a0b-1c2d-3456-1234-567890123456
		summarizeBy: none
		sourceColumn: is_holiday

		annotation SummarizationSetBy = Automatic

	column holiday_name
		dataType: string
		lineageTag: 8f9a0b1c-2d3e-4567-2345-678901234567
		summarizeBy: none
		sourceColumn: holiday_name

		annotation SummarizationSetBy = Automatic

	/// Hierarchies
	hierarchy 'Calendar Hierarchy'
		lineageTag: a1b2c3d4-e5f6-7890-3456-789012345678

		level Year
			column: year
			lineageTag: b2c3d4e5-f6a7-8901-4567-890123456789

		level Quarter
			column: quarter_name
			lineageTag: c3d4e5f6-a7b8-9012-5678-901234567890

		level Month
			column: month_name
			lineageTag: d4e5f6a7-b8c9-0123-6789-012345678901

		level Date
			column: full_date
			lineageTag: e5f6a7b8-c9d0-1234-7890-123456789012

	hierarchy 'Fiscal Hierarchy'
		lineageTag: f6a7b8c9-d0e1-2345-8901-234567890123

		level 'Fiscal Year'
			column: year
			lineageTag: a7b8c9d0-e1f2-3456-9012-345678901234

		level 'Fiscal Quarter'
			column: quarter_name
			lineageTag: b8c9d0e1-f2a3-4567-0123-456789012345

		level Month
			column: month_name
			lineageTag: c9d0e1f2-a3b4-5678-1234-567890123456

	/// DAX Measures
	measure 'Selected Date' = SELECTEDVALUE(dim_date[full_date])
		formatString: Short Date
		displayFolder: Date Intelligence

	measure 'Days in Period' = COUNTROWS(dim_date)
		formatString: #,0
		displayFolder: Date Intelligence

	measure 'First Date in Selection' = MIN(dim_date[full_date])
		formatString: Short Date
		displayFolder: Date Intelligence

	measure 'Last Date in Selection' = MAX(dim_date[full_date])
		formatString: Short Date
		displayFolder: Date Intelligence

	measure 'Is Weekend?' = 
		IF(
			SELECTEDVALUE(dim_date[is_weekend]) = TRUE(),
			"Weekend",
			"Weekday"
		)
		displayFolder: Date Intelligence

	/// Partition
	partition dim_date = m
		mode: import
		source = 
			let
				Source = AzureDatabricks.Catalogs("adb-####.##.azuredatabricks.net", "/sql/1.0/warehouses/####", [Catalog="nyc_taxi"]),
				gold = Source{[Name="gold"]}[Data],
				dim_date = gold{[Name="dim_date"]}[Data]
			in
				dim_date

	annotation PBI_ResultType = Table
	annotation __PBI_TimeIntelligenceEnabled = "1"
