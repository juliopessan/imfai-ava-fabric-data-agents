/// Relationships Definition
/// All relationships are MANY-TO-ONE with SINGLE cross-filter direction
/// Created: 2026-02-05
/// Author: Bianca (BiSemantic)

/// Relationship 1: fact_trips → dim_date
relationship fact_trips_dim_date
	fromColumn: fact_trips.date_sk
	toColumn: dim_date.date_sk
	fromCardinality: many
	toCardinality: one
	crossFilteringBehavior: oneDirection
	isActive: true
	relyOnReferentialIntegrity: true
	securityFilteringBehavior: bothDirections

/// Relationship 2: fact_trips → dim_payment
relationship fact_trips_dim_payment
	fromColumn: fact_trips.payment_type_sk
	toColumn: dim_payment.payment_type_sk
	fromCardinality: many
	toCardinality: one
	crossFilteringBehavior: oneDirection
	isActive: true
	relyOnReferentialIntegrity: true

/// Relationship 3: fact_trips → dim_rate
relationship fact_trips_dim_rate
	fromColumn: fact_trips.rate_code_sk
	toColumn: dim_rate.rate_code_sk
	fromCardinality: many
	toCardinality: one
	crossFilteringBehavior: oneDirection
	isActive: true
	relyOnReferentialIntegrity: true

/// Relationship 4: fact_trips → dim_trip_type
relationship fact_trips_dim_trip_type
	fromColumn: fact_trips.trip_type_sk
	toColumn: dim_trip_type.trip_type_sk
	fromCardinality: many
	toCardinality: one
	crossFilteringBehavior: oneDirection
	isActive: true
	relyOnReferentialIntegrity: true

/// Relationship 5: fact_trips → dim_location (Pickup)
/// Active Relationship
relationship fact_trips_dim_location_pickup
	fromColumn: fact_trips.pickup_location_sk
	toColumn: dim_location.location_sk
	fromCardinality: many
	toCardinality: one
	crossFilteringBehavior: oneDirection
	isActive: true
	relyOnReferentialIntegrity: true

/// Relationship 6: fact_trips → dim_location (Dropoff)
/// Inactive Relationship (use USERELATIONSHIP in DAX)
relationship fact_trips_dim_location_dropoff
	fromColumn: fact_trips.dropoff_location_sk
	toColumn: dim_location.location_sk
	fromCardinality: many
	toCardinality: one
	crossFilteringBehavior: oneDirection
	isActive: false
	relyOnReferentialIntegrity: true

/// Relationship Metadata
annotations
	__PBI_RelationshipCount = "6"
	__PBI_RolePlayingDimensions = "dim_location (Pickup/Dropoff)"
