// =====================================================
// DAX Measure Library: Sales Analytics Dashboard
// Generated: 2026-01-22 14:30
// Agent: InsightForge BI Developer v1.0
// =====================================================

// =====================================================
// BASE MEASURES - Core Aggregations
// =====================================================

Total Revenue = 
    SUM(FACT_SALES[Revenue])

Total Quantity = 
    SUM(FACT_SALES[Quantity])

Total Cost = 
    SUM(FACT_SALES[Cost])

Total Profit = 
    SUM(FACT_SALES[Profit])

Order Count = 
    COUNTROWS(FACT_SALES)

Average Order Value = 
    DIVIDE(
        [Total Revenue],
        [Order Count],
        0
    )

Average Unit Price = 
    AVERAGE(FACT_SALES[UnitPrice])

Profit Margin % = 
    DIVIDE(
        [Total Profit],
        [Total Revenue],
        0
    )

// =====================================================
// BUDGET MEASURES
// =====================================================

Budget Amount = 
    SUM(FACT_BUDGET[BudgetAmount])

Budget Quantity = 
    SUM(FACT_BUDGET[TargetQuantity])

Revenue vs Budget = 
    [Total Revenue] - [Budget Amount]

Revenue vs Budget % = 
    DIVIDE(
        [Revenue vs Budget],
        [Budget Amount],
        0
    )

Budget Attainment % = 
    DIVIDE(
        [Total Revenue],
        [Budget Amount],
        0
    )

// =====================================================
// TIME INTELLIGENCE - Period Comparisons
// =====================================================

Revenue LY = 
    CALCULATE(
        [Total Revenue],
        SAMEPERIODLASTYEAR(DIM_DATE[Date])
    )

Revenue YoY Change = 
    [Total Revenue] - [Revenue LY]

Revenue YoY % = 
    DIVIDE(
        [Revenue YoY Change],
        [Revenue LY],
        0
    )

Quantity LY = 
    CALCULATE(
        [Total Quantity],
        SAMEPERIODLASTYEAR(DIM_DATE[Date])
    )

Quantity YoY % = 
    DIVIDE(
        [Total Quantity] - [Quantity LY],
        [Quantity LY],
        0
    )

Revenue PM = 
    CALCULATE(
        [Total Revenue],
        DATEADD(DIM_DATE[Date], -1, MONTH)
    )

Revenue MoM Change = 
    [Total Revenue] - [Revenue PM]

Revenue MoM % = 
    DIVIDE(
        [Revenue MoM Change],
        [Revenue PM],
        0
    )

// =====================================================
// TIME INTELLIGENCE - Running Totals & Averages
// =====================================================

Revenue YTD = 
    TOTALYTD(
        [Total Revenue],
        DIM_DATE[Date]
    )

Revenue QTD = 
    TOTALQTD(
        [Total Revenue],
        DIM_DATE[Date]
    )

Revenue MTD = 
    TOTALMTD(
        [Total Revenue],
        DIM_DATE[Date]
    )

Revenue Rolling 30 Days = 
    CALCULATE(
        [Total Revenue],
        DATESINPERIOD(
            DIM_DATE[Date],
            MAX(DIM_DATE[Date]),
            -30,
            DAY
        )
    )

Avg Daily Revenue (30 Days) = 
    DIVIDE(
        [Revenue Rolling 30 Days],
        30,
        0
    )

Revenue Running Total = 
    CALCULATE(
        [Total Revenue],
        FILTER(
            ALLSELECTED(DIM_DATE[Date]),
            DIM_DATE[Date] <= MAX(DIM_DATE[Date])
        )
    )

// =====================================================
// RANKING & TOP N
// =====================================================

Product Revenue Rank = 
    IF(
        HASONEVALUE(DIM_PRODUCT[ProductName]),
        RANKX(
            ALL(DIM_PRODUCT[ProductName]),
            [Total Revenue],
            ,
            DESC,
            Dense
        )
    )

Region Revenue Rank = 
    IF(
        HASONEVALUE(DIM_REGION[Region]),
        RANKX(
            ALL(DIM_REGION[Region]),
            [Total Revenue],
            ,
            DESC,
            Dense
        )
    )

Is Top 10 Product = 
    IF([Product Revenue Rank] <= 10, 1, 0)

Top 10 Products Revenue = 
    CALCULATE(
        [Total Revenue],
        FILTER(
            ALL(DIM_PRODUCT),
            [Product Revenue Rank] <= 10
        )
    )

// =====================================================
// KPI INDICATORS & CONDITIONAL FORMATTING
// =====================================================

YoY Status = 
    SWITCH(
        TRUE(),
        [Revenue YoY %] >= 0.1, "▲ Strong Growth",
        [Revenue YoY %] >= 0, "▲ Growth",
        [Revenue YoY %] >= -0.1, "▼ Decline",
        "▼ Significant Decline"
    )

YoY Status Color = 
    SWITCH(
        TRUE(),
        [Revenue YoY %] >= 0.1, "#107C10",  // Green
        [Revenue YoY %] >= 0, "#008272",    // Teal
        [Revenue YoY %] >= -0.1, "#FFB900", // Yellow
        "#D13438"                            // Red
    )

Budget Status = 
    SWITCH(
        TRUE(),
        [Budget Attainment %] >= 1, "● On Track",
        [Budget Attainment %] >= 0.9, "● Near Target",
        [Budget Attainment %] >= 0.75, "● At Risk",
        "● Behind"
    )

Budget Status Color = 
    SWITCH(
        TRUE(),
        [Budget Attainment %] >= 1, "#107C10",
        [Budget Attainment %] >= 0.9, "#008272",
        [Budget Attainment %] >= 0.75, "#FFB900",
        "#D13438"
    )

// =====================================================
// SEGMENT ANALYSIS
// =====================================================

Revenue % of Total = 
    DIVIDE(
        [Total Revenue],
        CALCULATE(
            [Total Revenue],
            ALLSELECTED(FACT_SALES)
        ),
        0
    )

Revenue % of Category = 
    DIVIDE(
        [Total Revenue],
        CALCULATE(
            [Total Revenue],
            ALLSELECTED(DIM_PRODUCT[ProductName])
        ),
        0
    )

Customer Count = 
    DISTINCTCOUNT(FACT_SALES[CustomerKey])

Revenue per Customer = 
    DIVIDE(
        [Total Revenue],
        [Customer Count],
        0
    )

// =====================================================
// DYNAMIC MEASURES (for What-If Analysis)
// =====================================================

// Requires a "Growth Rate" parameter table
Projected Revenue = 
    [Total Revenue] * (1 + SELECTEDVALUE('Growth Rate'[Rate], 0))

// Requires a "Discount Rate" parameter table  
Revenue After Discount = 
    [Total Revenue] * (1 - SELECTEDVALUE('Discount Rate'[Rate], 0))

// =====================================================
// UTILITY MEASURES
// =====================================================

Has Data = 
    IF(NOT(ISBLANK([Total Revenue])), 1, 0)

Selected Region = 
    IF(
        HASONEVALUE(DIM_REGION[Region]),
        SELECTEDVALUE(DIM_REGION[Region]),
        "All Regions"
    )

Selected Period = 
    VAR MinDate = MIN(DIM_DATE[Date])
    VAR MaxDate = MAX(DIM_DATE[Date])
    RETURN
        FORMAT(MinDate, "MMM DD, YYYY") & " - " & FORMAT(MaxDate, "MMM DD, YYYY")

Last Refresh = 
    NOW()

// =====================================================
// END OF MEASURE LIBRARY
// =====================================================
